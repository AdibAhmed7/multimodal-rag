# ==============================================================================
# Multimodal RAG Environment Variables
# Copy this file to .env and customize values for your environment.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Online Cloud API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_token_here

# Execution Mode (online / offline)
MODEL_EXECUTION_MODE=online
CLOUD_PROVIDER=gemini

# Vector Database (Qdrant / Chroma)
VECTORSTORE_TYPE=qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# Embedding Model Configurations
TEXT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
IMAGE_EMBEDDING_MODEL=openai/clip-vit-base-patch32

# Chunking Configurations
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=150

# Storage Paths
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
MODELS_CACHE_DIR=models
